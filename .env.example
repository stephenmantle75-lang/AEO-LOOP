# Safe to commit. Put real values in a local .env file or the Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=https://kufgerwuvilhtxhjrsbl.supabase.co
# Use the publishable key in browser auth clients; never use the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Collection providers. These are read only by server-side jobs.
EXA_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=

# Protects scheduled endpoints from public callers.
CRON_SECRET=

# Safe first-run controls. Increase only after reviewing provider cost and output.
AEO_TARGET_URL=https://www.stephenmantle.com/insights/seo-vs-aeo-portfolio
AEO_VARIANT_TARGET_URL=https://www.stephenmantle.com/insights/seo-vs-aeo-portfolio-variant-b
AEO_MAX_EXA_PROMPTS=1
# Calendar boundary for daily run keys and claim metadata; Vercel cron remains UTC.
AEO_REPORTING_TIMEZONE=UTC
# Optional hard stop for completed provider spend in the current UTC calendar month.
# Leave blank until the monthly provider budget is intentionally approved.
AEO_MONTHLY_PROVIDER_BUDGET_USD=
# Keep off until the analysis review policy is approved.
AEO_ANALYSIS_PERSISTENCE_ENABLED=false
# Review authentication is opt-in until the Supabase Auth provider and owner account are configured.
AEO_REVIEW_AUTH_ENABLED=false
# The UUID of the one Supabase Auth user allowed to approve or reject analyses.
AEO_REVIEWER_USER_ID=
